# ==============================================================================
# EliteStay Environment Variables Template (.env.example)
# ==============================================================================
# Duplicate this file to .env.local and populate with your project credentials:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure
# ------------------------------------------------------------------------------
# Project URL (e.g., https://<project-id>.supabase.co or http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Client-safe Publishable / Anon API Key (JWT)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Redis & Distributed Caching Subsystem
# ------------------------------------------------------------------------------
# Standard Redis connection URI (supports redis:// and rediss:// TLS protocols)
# Example (Local Docker): redis://localhost:6379
# Example (Upstash / Cloud): rediss://default:<password>@<host>:6379
REDIS_URL="redis://127.0.0.1:6379"

# Optional Upstash HTTP REST fallback (used when REDIS_URL is not set)
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------------------------
# 3. Application & Deployment URLs
# ------------------------------------------------------------------------------
# Base URL for the website (used for authentication callbacks and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical Application URL (used for SEO structured data and schema.org JSON-LD)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application Version
NEXT_PUBLIC_APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 4. End-to-End & Integration Testing
# ------------------------------------------------------------------------------
# Base URL for Playwright tests
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. Domain Provider Services
# ------------------------------------------------------------------------------
# Search backend provider ('supabase' | 'algolia' | 'elasticsearch')
SEARCH_PROVIDER=supabase

# Notification delivery provider ('noop' | 'resend' | 'sendgrid')
NOTIFICATION_PROVIDER=noop

# ------------------------------------------------------------------------------
# 6. Observability Platform Configuration
# ------------------------------------------------------------------------------
# Request duration thresholds in milliseconds
OBSERVABILITY_SLOW_THRESHOLD_MS=100
OBSERVABILITY_CRITICAL_THRESHOLD_MS=500

# Query anomaly thresholds
OBSERVABILITY_DUPLICATE_QUERY_THRESHOLD=3
OBSERVABILITY_N_PLUS_ONE_THRESHOLD=3

# In-memory telemetry ring buffer capacity
OBSERVABILITY_RING_BUFFER_SIZE=2000

# Optional OpenTelemetry Collector OTLP Endpoint (HTTP/protobuf or gRPC)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
