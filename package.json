{
  "name": "elitestay",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "esbuild": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
